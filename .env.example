# Paths are relative to the repository unless absolute paths are supplied.
DATA_DIR=./data
ROAD_DISTRESS_DOC_DIR=raw
ROAD_DISTRESS_WEB_DB=runtime/web-workflow.sqlite3
ROAD_DISTRESS_MEMORY_DB=runtime/long_term_memory.sqlite3
ROAD_DISTRESS_PROJECT_DB=runtime/inspection_projects.sqlite3
ROAD_DISTRESS_DELIVERY_INDEX_DB=runtime/delivery_index.sqlite3
ROAD_DISTRESS_DELIVERY_DIR=runtime/deliverables
ROAD_DISTRESS_WEB_UPLOADS=./data/uploads

# Set `dev` to start without model calls; use `live` after configuring providers.
ROAD_DISTRESS_RUN_MODE=dev
ROAD_DISTRESS_WEB_HOST=127.0.0.1
ROAD_DISTRESS_WEB_PORT=8010

# Retrieval service and index. Start Qdrant with `docker compose up -d qdrant`.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=road_distress_documents
QDRANT_TOP_K=5

# Text model used in live mode.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_STRUCTURED_METHOD=json_mode

# Optional vision model; required only when live mode processes an image.
DASHSCOPE_API_KEY=
QWEN_VL_BASE_URL=
QWEN_VL_MODEL=

# Optional contextual-enrichment model for the PDF ingestion pipeline.
CONTEXTUAL_LLM_BASE_URL=
CONTEXTUAL_LLM_MODEL=

# Optional external weather and search services.
APISPACE_TOKEN=
TAVILY_API_KEY=

# Optional, user-provided cost norm database. It is never bundled with this repository.
ROAD_DISTRESS_NORM_DB=
